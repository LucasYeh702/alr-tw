# ALR-TW v1.0.0-rc.1 candidate (package 1.0.0rc1). Never commit real credentials.

# Default: synthetic (offline, no external requests).
# Live choices: official_only | hybrid_verified
ALR_TW_DATA_MODE=synthetic

# Managed SQLite state. Default: ~/.cache/alr-tw
# ALR_TW_STORAGE_PATH=~/.cache/alr-tw

# 1s..7d; default 24h. Per-run MCP constraints may use "ephemeral".
ALR_TW_RETENTION=24h

# TLR is contacted only in hybrid_verified mode after the privacy gate.
ALR_TW_TLR_BASE_URL=https://tlr.dr-lawbot.com
# ALR_TW_TLR_API_KEY=

# Legacy opt-in demo path for a resolver-backed judgment cache.
# ALR_TW_IDENTIFIER_BACKED_VERIFIED_CACHE=0

# Optional RC4 authenticated local judgment pack; set BOTH after import-pack.
# The trust key is external to the pack and repository; never commit it.
# ALR_TW_DATA_PACK_ROOT=
# ALR_TW_DATA_PACK_KEY_FILE=
# Pack lookup is local; other providers keep their configured network behavior.
# Semantic advice is opt-in via advise-draft --gateway-config, not enabled here.

# Optional remote exact pack (requires live or tlr extra); do not set local root.
# HTTPS endpoint, port 443, no credentials/query/fragment; external key required.
# ALR_TW_REMOTE_PACK_ENDPOINT=
# ALR_TW_REMOTE_PACK_SNAPSHOT=

# Server-owned research I/O budget; applies to NEW runs only.
# Deadline starts at first advancement or run-bound lookup and includes idle time.
ALR_TW_RESEARCH_MAX_SECONDS=120
ALR_TW_RESEARCH_MAX_HTTP_REQUESTS=50
# External-client model tokens are unknown and must be limited by that client.
